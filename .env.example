# Copy to .env.local if you need to override defaults.

# Base URL of the API as seen by the browser.
# Default "/api/v1" works in dev thanks to the Vite proxy (vite.config.ts).
# For production: the deployed API, e.g. https://dailyvy-api.onrender.com/api/v1
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api (the Express server).
# VITE_API_PROXY_TARGET=http://localhost:4000

# Path the site is served from (GitHub Pages: /<repo-name>/)
# VITE_BASE=/dailyvy-admin/
